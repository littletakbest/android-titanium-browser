  <!-- Titanium: ECH toggle and proxy settings (net_settings/, inserted by patch.sh) -->
  <message name="IDS_ENCRYPTED_CLIENT_HELLO_TITLE" desc="Title of the Encrypted Client Hello toggle in Privacy and security settings">
    Encrypted Client Hello (ECH)
  </message>
  <message name="IDS_ENCRYPTED_CLIENT_HELLO_SUMMARY" desc="Summary of the Encrypted Client Hello toggle">
    Hide the name of the site you're connecting to from your network, on sites that support it
  </message>
  <message name="IDS_CUSTOM_PROXY_TITLE" desc="Title of the proxy settings entry and page">
    Proxy
  </message>
  <message name="IDS_CUSTOM_PROXY_SUMMARY_SYSTEM" desc="Summary of the proxy entry when the system proxy is used">
    Using Android system proxy settings
  </message>
  <message name="IDS_CUSTOM_PROXY_SUMMARY_MANAGED" desc="Shown when the proxy is controlled by something other than this page">
    Controlled by chrome://flags, an extension, or your administrator
  </message>
  <message name="IDS_CUSTOM_PROXY_ENABLE_TITLE" desc="Title of the switch that turns on the custom proxy">
    Use a custom proxy
  </message>
  <message name="IDS_CUSTOM_PROXY_ENABLE_SUMMARY" desc="Summary of the switch that turns on the custom proxy">
    Route browser traffic through the proxy below instead of the Android system proxy
  </message>
  <message name="IDS_CUSTOM_PROXY_SERVER_TITLE" desc="Title of the proxy server setting and dialog">
    Proxy server
  </message>
  <message name="IDS_CUSTOM_PROXY_SERVER_HINT" desc="Example shown in the empty proxy server field">
    socks5://127.0.0.1:1080
  </message>
  <message name="IDS_CUSTOM_PROXY_SERVER_NOT_SET" desc="Summary when no proxy server is set">
    Not set
  </message>
  <message name="IDS_CUSTOM_PROXY_SERVER_INVALID" desc="Error when the entered proxy server can't be parsed">
    Enter a valid proxy, for example socks5://host:port
  </message>
  <message name="IDS_CUSTOM_PROXY_BYPASS_TITLE" desc="Title of the proxy bypass list setting and dialog">
    Bypass list
  </message>
  <message name="IDS_CUSTOM_PROXY_BYPASS_HINT" desc="Example shown in the empty bypass list field">
    *.lan;192.168.0.0/16
  </message>
  <message name="IDS_CUSTOM_PROXY_BYPASS_NONE" desc="Summary when the bypass list is empty">
    None
  </message>
  <message name="IDS_CUSTOM_PROXY_HELP" desc="Explanation of the accepted proxy formats">
    Proxy formats: http://host:port, https://host:port, socks4://host:port or socks5://host:port (SOCKS5 resolves site names on the proxy). Per-scheme rules such as http=host:port;https=host:port also work. Bypass list entries are separated by semicolons or commas. Local addresses always connect directly.
  </message>
